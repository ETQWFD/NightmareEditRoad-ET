<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <!-- 405：背景层原来是深紫黑渐变，而字标也是深色墨，叠在一起就是“中间的字看不到”。
         现在改成与 App 内一致的冷白玻璃渐变，深色粗字在白底上对比度最高。 -->
    <path android:pathData="M0,0 H1024 V1024 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="1024"
                android:endY="1024">
                <item android:offset="0.0" android:color="#FFFBFDFF" />
                <item android:offset="0.52" android:color="#FFF1F5FA" />
                <item android:offset="1.0" android:color="#FFE4EAF3" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
